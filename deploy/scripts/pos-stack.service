# Optional: /etc/systemd/system/pos-stack.service
# (containers already auto-restart via restart: unless-stopped; this just makes
# start/stop/status behave like a normal service: systemctl restart pos-stack)
[Unit]
Description=POS sync stack (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pos
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

