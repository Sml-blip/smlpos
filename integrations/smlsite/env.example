# SMLSITE — copy to Vercel / Inngest (server-side only)
# Never prefix secrets with NEXT_PUBLIC_

# Same Supabase project as SMLPOS (from Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# SMLSITE shop database (Turso) — your project
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Inngest (optional Phase 2 enrich)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Gemini (Phase 2 — descriptions; not used by POS)
GEMINI_API_KEY=

# Optional: image search (Phase 2)
# SERPER_API_KEY=

